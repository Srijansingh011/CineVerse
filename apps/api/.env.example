# Server configuration
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database configurations
DATABASE_URL=postgresql://postgres:password@localhost:5432/cineverse?schema=public
REDIS_URL=redis://localhost:6379

# Authentication JWT secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_should_be_long_and_random
JWT_REFRESH_SECRET=your_jwt_refresh_secret_should_be_long_and_random

# TMDB Movie API Key
TMDB_API_KEY=your_tmdb_api_key

# Razorpay payments keys
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Cloudinary media storage configurations
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email service SMTP configurations (optional/later)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@cineverse.com
